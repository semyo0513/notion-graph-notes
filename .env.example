# Notion API 및 배포 환경 변수 템플릿 (.env로 복사하여 사용)
# 주의: 이 파일(.env)은 절대 깃허브 저장소에 커밋하지 마세요 (.gitignore 등록됨)

# 1. Notion 내부 통합 시크릿 토큰 (secret_...)
NOTION_TOKEN=secret_your_notion_api_token_here

# 2. Notion 데이터베이스 또는 데이터 소스 ID
# (Notion DB URL 또는 Manage data sources -> Copy data source ID)
DATA_SOURCE_ID=your_data_source_id_or_database_id

# 3. 데이터 암호화용 패스프레이즈 (16자 이상의 무작위 문장 권장)
# 웹 프론트엔드에서 데이터 복호화 시에도 동일한 비밀번호를 입력해야 합니다.
DATA_PASSPHRASE=your_secure_passphrase_here
